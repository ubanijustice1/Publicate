# Supabase (safe to expose in frontend — protected by Row Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Paystack public key (safe to expose in frontend)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Ad Manager rewarded ad unit path (safe to expose in frontend).
# Leave empty to use Google's test rewarded ad. Note: AdMob IDs (ca-app-pub-...) only work in native apps.
VITE_GAM_REWARDED_AD_UNIT=

# --- Server-only secrets (used by Netlify Functions, never exposed to the browser) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
